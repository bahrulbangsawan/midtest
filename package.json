{
  "name": "midtest",
  "version": "1.0.0",
  "description": "MidTest desktop agent for AI-powered application testing",
  "main": "index.js",
  "scripts": {
    "test": "npm run test --workspace=midscene-mcp && npm test --prefix app",
    "typecheck": "npm run typecheck --workspace=midscene-mcp && npm run typecheck --prefix app",
    "build": "npm run build --prefix app",
    "playground": "node --env-file=.env node_modules/@midscene/computer-playground/bin/computer-playground",
    "example": "node --env-file=.env example.ts"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "module",
  "workspaces": [
    "midscene-mcp"
  ],
  "dependencies": {
    "@midscene/computer": "^1.10.8",
    "@midscene/computer-playground": "^1.10.8",
    "@midscene/web": "^1.10.8",
    "zod": "^4.4.3"
  },
  "allowScripts": {
    "node-mac-permissions@2.5.0": true,
    "sharp@0.34.5": true
  }
}
