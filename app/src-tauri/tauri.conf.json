{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "MidTest",
  "version": "0.1.0",
  "identifier": "com.midtest.desktop",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "MidTest",
        "width": 1180,
        "height": 760,
        "minWidth": 720,
        "minHeight": 520
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "resources": {
      "../../midscene-mcp": "midscene-runtime/midscene-mcp",
      "../../node_modules": "midscene-runtime/node_modules",
      "../../build-demo.js": "midscene-runtime/build-demo.js"
    },
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
